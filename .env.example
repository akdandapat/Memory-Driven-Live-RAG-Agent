# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# demo = seeded local Jira-shaped source through the same connector interface
# live = real Jira Cloud REST API
APP_MODE=demo
APP_HOST=0.0.0.0
APP_PORT=8000
DEFAULT_USER_ID=demo-user
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Jira (LIVE mode only). Never commit real values.
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# ---------------------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Comma separated allow-list. Empty string = allow every project the token can read.
JIRA_ALLOWED_PROJECTS=
JIRA_TIMEOUT_SECONDS=30
JIRA_MAX_RETRIES=3
JIRA_PAGE_SIZE=50

# DEMO mode data directory (JSON files that a script can mutate to simulate live change)
MOCK_DATA_DIR=data/mock_jira

# ---------------------------------------------------------------------------
# LLM. provider = none | openai | anthropic
# "none" runs the deterministic heuristic planner/synthesizer (no API key needed).
# LLM_BASE_URL lets you point the OpenAI-compatible client at Ollama, vLLM, OpenRouter, Azure.
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Embeddings. provider = hashing | openai
# hashing = deterministic local lexical embedding (no network, lower quality)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=512
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DB_PATH=data/app.db

# ---------------------------------------------------------------------------
# MCP transport: inproc | stdio | http
#   inproc = MCP server object hosted inside the API process (same protocol, no subprocess)
#   stdio  = MCP server launched as a subprocess, JSON-RPC over stdin/stdout
#   http   = remote MCP server over Streamable HTTP (set MCP_SERVER_URL)
# ---------------------------------------------------------------------------
MCP_TRANSPORT=inproc
MCP_SERVER_URL=http://localhost:8765/mcp
MCP_TOOL_TIMEOUT_SECONDS=45

# ---------------------------------------------------------------------------
# Agent execution budget (loop protection)
# ---------------------------------------------------------------------------
AGENT_MAX_TOOL_CALLS=18
AGENT_MAX_ROUNDS=3
AGENT_MAX_SUB_QUESTIONS=6
AGENT_MAX_EVIDENCE=60
AGENT_EVIDENCE_CHARS=1200

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
MEMORY_TOP_K=5
MEMORY_MIN_IMPORTANCE=0.35
MEMORY_MIN_RELEVANCE=0.30
MEMORY_CONFLICT_SIMILARITY=0.80
MEMORY_DUPLICATE_SIMILARITY=0.94
MEMORY_MAX_PER_USER=300

# ---------------------------------------------------------------------------
# Observability (LangSmith is optional; local SQLite tracing is always on)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-live-data
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
